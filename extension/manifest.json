{
  "manifest_version": 3,
  "name": "Naver → Google Maps 저장 목록",
  "version": "0.6.0",
  "description": "네이버 지도 공유 목록의 장소를 구글지도 저장 목록에 하나씩 저장합니다 (시제품).",
  "permissions": ["tabs", "scripting", "storage", "alarms", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://www.google.com/*",
    "https://naver.me/*",
    "https://map.naver.com/*",
    "https://pages.map.naver.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "구글지도 목록으로 저장",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  }
}
